NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Simple admin gate for /admin.
# Use a long random value in production.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

# Payments (iKhokha iK Pay API — get these from the merchant's
# IK Dashboard: https://dashboard.ikhokha.com -> Integrations -> iK Pay API)
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=

# Google Places address autocomplete at checkout. Optional — without it the
# checkout falls back to plain manual address entry.
# Requires a Google Cloud project with billing enabled and "Places API (New)".
# MUST be restricted by HTTP referrer: this key is exposed in the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
