# iKhokha — get these from the client's IK Dashboard (Integrations -> iK Pay API)
# when the merchant account is approved. There's no sandbox/test mode, and
# iKhokha needs a public URL to reach the webhook — use an ngrok tunnel for
# local dev and set NEXT_PUBLIC_SITE_URL to that tunnel URL while testing.
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
